@model dynamic
<div>
@{
    int pagesAdded = 0;
    @for (int i = Model.PageNumber - 5; i <= Model.PageNumber + 5; i++)
    {
        if (i > 0)
        {
            <a asp-page="/@Model.PageName" asp-route-PageNumber="@i">@i</a>
            pagesAdded += 1;

            if (pagesAdded >= 7)
            {
                break;
            }
        }
    }
}
</div>