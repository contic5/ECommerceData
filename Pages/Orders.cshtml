@page "/Orders/{PageNumber:int?}"
@using EcommerceData.Models
@model OrdersModel
@{
    ViewData["Title"] = "Orders";
}

<div class="text-center">
    <h1 class="display-4">Orders</h1>
    <form>
    <h2>Sort By</h2>
    <select asp-for="SortBy" asp-items="Model.SortByItems"></select>
    <select asp-for="SortAscending">
    <option value=true>- to +</option>
    <option value=false>+ to -</option>
    </select>
    <button type="submit">Submit</button>
    </form>

    
    @{
        var myDataModel = new { PageName = "Orders", PageNumber = Model.PageNumber};
    }
    @await Html.PartialAsync("_MakePagesPartial", myDataModel)

    <h2>Orders</h2>
    <table>
    @await Html.PartialAsync(partialViewName: "_MakeTableHead", new {firstItem=Model.Orders[0]})
    @await Html.PartialAsync(partialViewName:"_MakeTableBody",new {items=Model.Orders})
    </table>
    @await Html.PartialAsync("_MakePagesPartial", myDataModel)

</div>