@page "/Sales/{PageNumber:int?}"
@using EcommerceData.Models
@model SalesModel
@{
    ViewData["Title"] = "Sales";
}

<div class="text-center">
    <h1 class="display-4">Products</h1>
    <form>
    <h2>Sort By</h2>
    <select asp-for="SortBy" asp-items="Model.SortByItems"></select>
    <select asp-for="SortAscending">
    <option value=true>- to +</option>
    <option value=false>+ to -</option>
    </select>
    <h2>Filters</h2>
    <label asp-for="OrderStatus">Select an Order Status:</label>
    <select asp-for="OrderStatus" asp-items="Model.OrderStatusOptions" class="form-control">
        <option value="">-- Choose a Category --</option>
    </select>

    <label asp-for="SalesChannel">Select a Sales Channel:</label>
    <select asp-for="SalesChannel" asp-items="Model.SalesChannelOptions" class="form-control">
        <option value="">-- Choose a Sales Channel --</option>
    </select>

    <label asp-for="CustomerSegment">Select a Customer Segment:</label>
    <select asp-for="CustomerSegment" asp-items="Model.CustomerSegmentOptions" class="form-control">
        <option value="">-- Choose a Customer Segment --</option>
    </select>

    <label asp-for="CustomerCountry">Select a Country:</label>
    <select asp-for="CustomerCountry" asp-items="Model.CustomerCountryOptions" class="form-control">
        <option value="">-- Choose a Country --</option>
    </select>

    <label asp-for="PaymentMethod">Select a Payment Method:</label>
    <select asp-for="PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-control">
        <option value="">-- Choose a Payment Method --</option>
    </select>

    <label asp-for="PaymentStatus">Select a Payment Status:</label>
    <select asp-for="PaymentStatus" asp-items="Model.PaymentStatusOptions" class="form-control">
        <option value="">-- Choose a Payment Status --</option>
    </select>

    <label asp-for="ShippingMethod">Select a Shipping Method:</label>
    <select asp-for="ShippingMethod" asp-items="Model.ShippingMethodOptions" class="form-control">
        <option value="">-- Choose a Shipping Method --</option>
    </select>

    <label asp-for="ReturnStatus">Select a Return Status:</label>
    <select asp-for="ReturnStatus" asp-items="Model.ReturnStatusOptions" class="form-control">
        <option value="">-- Choose a Return Status --</option>
    </select>

    <label asp-for="MarketingChannel">Select a Marketing Channel:</label>
    <select asp-for="MarketingChannel" asp-items="Model.MarketingChannelOptions" class="form-control">
        <option value="">-- Choose a Marketing Channel --</option>
    </select>

    <button type="submit">Submit</button>
    </form>

     @{
        var myDataModel = new { PageName = "Sales", PageNumber = Model.PageNumber};
    }
    @await Html.PartialAsync("_MakePagesPartial", myDataModel)

    <h2>Sales</h2>
    <table>
    <thead>
    <tr>
    <th>OrderId</th>
    <th>OrderDate</th>
    <th>OrderTime</th>
    <th>OrderStatus</th>
    <th>SalesChannel</th>
    <th>CustomerId</th>
    <th>CustomerName</th>
    <th>CustomerAge</th>
    <th>Gender</th>
    <th>CustomerSegment</th>
    <th>CustomerType</th>
    <th>CustomerCity</th>
    <th>CustomerState</th>
    <th>CustomerCountry</th>
    <th>Region</th>
    <th>CustomerPostalCode</th>
    <th>PaymentMethod</th>
    <th>PaymentStatus</th>
    <th>Currency</th>
    <th>ShippingMethod</th>
    <th>Warehouse</th>
    <th>DeliveryDays</th>
    <th>EstimatedDeliveryDays</th>
    <th>DeliveryStatus</th>
    <th>ReturnStatus</th>
    <th>ReturnReason</th>
    <th>CustomerRating</th>
    <th>ReviewSentiment</th>
    <th>CustomerReview</th>
    <th>MarketingChannel</th>
    <th>CampaignName</th>
    <th>CouponCode</th>
    <th>LoyaltyPointsEarned</th>
    <th>LoyaltyPointsRedeemed</th>
    <th>Quantity</th>
    <th>GrossSales</th>
    <th>DiscountAmount</th>
    <th>TaxAmount</th>
    <th>ShippingCost</th>
    <th>NetSales</th>
    <th>ProductCost</th>
    <th>Profit</th>
    <th>ProfitMarginPercentage</th>
    <th>CustomerLifetimeValue</th>
    <th>IsRepeatCustomer</th>
    <th>CustomerOrderCount</th>
    </tr>
    </thead>
    <tbody>
    @foreach(Sale sale in Model.Sales)
    {
        <tr>
        <td>@sale.OrderId</td>
        <td>@sale.OrderDate</td>
        <td>@sale.OrderTime</td>
        <td>@sale.OrderStatus</td>
        <td>@sale.SalesChannel</td>
        <td>@sale.CustomerId</td>
        <td>@sale.CustomerName</td>
        <td>@sale.CustomerAge</td>
        <td>@sale.Gender</td>
        <td>@sale.CustomerSegment</td>
        <td>@sale.CustomerType</td>
        <td>@sale.CustomerCity</td>
        <td>@sale.CustomerState</td>
        <td>@sale.CustomerCountry</td>
        <td>@sale.Region</td>
        <td>@sale.CustomerPostalCode</td>
        <td>@sale.PaymentMethod</td>
        <td>@sale.PaymentStatus</td>
        <td>@sale.Currency</td>
        <td>@sale.ShippingMethod</td>
        <td>@sale.Warehouse</td>
        <td>@sale.DeliveryDays</td>
        <td>@sale.EstimatedDeliveryDays</td>
        <td>@sale.DeliveryStatus</td>
        <td>@sale.ReturnStatus</td>
        <td>@sale.ReturnReason</td>
        <td>@sale.CustomerRating</td>
        <td>@sale.ReviewSentiment</td>
        <td>@sale.CustomerReview</td>
        <td>@sale.MarketingChannel</td>
        <td>@sale.CampaignName</td>
        <td>@sale.CouponCode</td>
        <td>@sale.LoyaltyPointsEarned</td>
        <td>@sale.LoyaltyPointsRedeemed</td>
        <td>@sale.Quantity</td>
        <td>@sale.GrossSales</td>
        <td>@sale.DiscountAmount</td>
        <td>@sale.TaxAmount</td>
        <td>@sale.ShippingCost</td>
        <td>@sale.NetSales</td>
        <td>@sale.ProductCost</td>
        <td>@sale.Profit</td>
        <td>@sale.ProfitMarginPercentage</td>
        <td>@sale.CustomerLifetimeValue</td>
        <td>@sale.IsRepeatCustomer</td>
        <td>@sale.CustomerOrderCount</td>
        </tr>
    }
    </tbody>
    </table>

    @await Html.PartialAsync("_MakePagesPartial", myDataModel)
</div>