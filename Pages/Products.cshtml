@page "/Products/{PageNumber:int?}"
@using EcommerceData.Models
@model ProductsModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Products</h1>
    <form>
    <h2>Sort By</h2>
    <select asp-for="SortBy" asp-items="Model.SortByItems"></select>
    <select asp-for="SortAscending">
    <option value=true>- to +</option>
    <option value=false>+ to -</option>
    </select>
    <h2>Filters</h2>
    <label asp-for="ProductCategory">Select a Category:</label>
    <select asp-for="ProductCategory" asp-items="Model.ProductCategoryOptions" class="form-control">
        <option value="">-- Choose a Category --</option>
    </select>

    <label asp-for="ProductSubCategory">Select a SubCategory:</label>
    <select asp-for="ProductSubCategory" asp-items="Model.ProductSubCategoryOptions" class="form-control">
        <option value="">-- Choose a SubCategory --</option>
    </select>

    <label asp-for="Brand">Select a Brand:</label>
    <select asp-for="Brand" asp-items="Model.BrandOptions" class="form-control">
        <option value="">-- Choose a Brand --</option>
    </select>

    <label asp-for="Supplier">Select a Supplier:</label>
    <select asp-for="Supplier" asp-items="Model.SupplierOptions" class="form-control">
        <option value="">-- Choose a Supplier --</option>
    </select>

    <button type="submit">Submit</button>
    </form>

    @{
        var myDataModel = new { PageName = "Products", PageNumber = Model.PageNumber};
    }
    @await Html.PartialAsync("_MakePagesPartial", myDataModel)

    <h2>Customers</h2>
    <table>
    <thead>
    <tr>
    <th>Name</th>
    <th>Category</th>
    <th>SubCategory</th>
    <th>Brand</th>
    <th>City</th>
    <th>UnitPrice</th>
    <th>ProductCost</th>
    <th>ProductRating</th>
    </tr>
    </thead>
    <tbody>
    @foreach(Product product in Model.Products)
    {
        <tr>
        <td>@product.ProductName</td>
        <td>@product.ProductCategory</td>
        <td>@product.ProductSubCategory</td>
        <td>@product.Brand</td>
        <td>@product.Supplier</td>
        <td>@product.UnitPrice</td>
        <td>@product.ProductCost</td>
        <td>@product.ProductRating</td>
        </tr>
    }
    </tbody>
    </table>

    @await Html.PartialAsync("_MakePagesPartial", myDataModel)
</div>